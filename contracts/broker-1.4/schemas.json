{
 "zeoconnect:1.4:common": {
  "$id": "zeoconnect:1.4:common",
  "$defs": {
   "sha": {
    "type": "string",
    "pattern": "^[0-9a-f]{40}$"
   },
   "sha256": {
    "type": "string",
    "pattern": "^[0-9a-f]{64}$"
   },
   "repository": {
    "type": "string",
    "pattern": "^[A-Za-z0-9-]{1,39}/[A-Za-z0-9._-]{1,100}$"
   },
   "branch": {
    "type": "string",
    "minLength": 1,
    "maxLength": 250
   },
   "path": {
    "type": "string",
    "minLength": 1,
    "maxLength": 4096
   },
   "cursor": {
    "type": "string",
    "pattern": "^[A-Za-z0-9_-]{1,512}$"
   },
   "execution_id": {
    "type": "string",
    "pattern": "^exe_[A-Za-z0-9_-]{1,64}$"
   },
   "idempotency_key": {
    "type": "string",
    "pattern": "^[A-Za-z0-9._:-]{32,128}$"
   },
   "triple": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "record_id",
     "revision",
     "record_sha256"
    ],
    "properties": {
     "record_id": {
      "type": "string",
      "maxLength": 128
     },
     "revision": {
      "type": "integer",
      "minimum": 1
     },
     "record_sha256": {
      "$ref": "#/$defs/sha256"
     }
    }
   },
   "authenticated_as": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "host_id",
     "host_incarnation",
     "os_account",
     "account_incarnation"
    ],
    "properties": {
     "host_id": {
      "type": "string",
      "pattern": "^host_[A-Za-z0-9_-]{1,64}$"
     },
     "host_incarnation": {
      "type": "integer",
      "minimum": 1
     },
     "os_account": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
     },
     "account_incarnation": {
      "type": "integer",
      "minimum": 1
     }
    }
   },
   "on_behalf_of": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "principal_id",
     "incarnation",
     "authenticated_as"
    ],
    "properties": {
     "principal_id": {
      "type": "string",
      "pattern": "^prn_[A-Za-z0-9_-]{1,64}$"
     },
     "incarnation": {
      "type": "integer",
      "minimum": 1
     },
     "authenticated_as": {
      "$ref": "#/$defs/authenticated_as"
     }
    }
   }
  }
 },
 "zeoconnect:1.4:request": {
  "$id": "zeoconnect:1.4:request",
  "type": "object",
  "additionalProperties": false,
  "required": [
   "connection_id",
   "operation_id",
   "arguments",
   "idempotency_key",
   "on_behalf_of",
   "door_request_id"
  ],
  "properties": {
   "connection_id": {
    "type": "string",
    "pattern": "^role_[A-Za-z0-9_-]{1,64}$"
   },
   "operation_id": {
    "enum": [
     "github.git.publish",
     "github.git.reconcile",
     "github.intent.resolve",
     "github.pr.open",
     "github.pr.update",
     "github.contents.read",
     "github.pr.read",
     "github.checks.read",
     "github.pr.list",
     "github.ref.read",
     "github.fork.sync"
    ]
   },
   "arguments": {
    "type": "object"
   },
   "idempotency_key": {
    "$ref": "zeoconnect:1.4:common#/$defs/idempotency_key"
   },
   "on_behalf_of": {
    "$ref": "zeoconnect:1.4:common#/$defs/on_behalf_of"
   },
   "door_request_id": {
    "type": "string",
    "pattern": "^[A-Za-z0-9._:-]{8,128}$"
   }
  },
  "allOf": [
   {
    "if": {
     "properties": {
      "operation_id": {
       "const": "github.git.publish"
      }
     }
    },
    "then": {
     "properties": {
      "arguments": {
       "$ref": "zeoconnect:1.4:publish.arguments"
      }
     }
    }
   },
   {
    "if": {
     "properties": {
      "operation_id": {
       "const": "github.git.reconcile"
      }
     }
    },
    "then": {
     "properties": {
      "arguments": {
       "$ref": "zeoconnect:1.4:reconcile.arguments"
      }
     }
    }
   },
   {
    "if": {
     "properties": {
      "operation_id": {
       "const": "github.intent.resolve"
      }
     }
    },
    "then": {
     "properties": {
      "arguments": {
       "$ref": "zeoconnect:1.4:resolve.arguments"
      }
     }
    }
   },
   {
    "if": {
     "properties": {
      "operation_id": {
       "const": "github.pr.open"
      }
     }
    },
    "then": {
     "properties": {
      "arguments": {
       "$ref": "zeoconnect:1.4:pr_open.arguments"
      }
     }
    }
   },
   {
    "if": {
     "properties": {
      "operation_id": {
       "const": "github.pr.update"
      }
     }
    },
    "then": {
     "properties": {
      "arguments": {
       "$ref": "zeoconnect:1.4:pr_update.arguments"
      }
     }
    }
   },
   {
    "if": {
     "properties": {
      "operation_id": {
       "const": "github.contents.read"
      }
     }
    },
    "then": {
     "properties": {
      "arguments": {
       "$ref": "zeoconnect:1.4:contents_read.arguments"
      }
     }
    }
   },
   {
    "if": {
     "properties": {
      "operation_id": {
       "const": "github.pr.read"
      }
     }
    },
    "then": {
     "properties": {
      "arguments": {
       "$ref": "zeoconnect:1.4:pr_read.arguments"
      }
     }
    }
   },
   {
    "if": {
     "properties": {
      "operation_id": {
       "const": "github.checks.read"
      }
     }
    },
    "then": {
     "properties": {
      "arguments": {
       "$ref": "zeoconnect:1.4:checks_read.arguments"
      }
     }
    }
   },
   {
    "if": {
     "properties": {
      "operation_id": {
       "const": "github.pr.list"
      }
     }
    },
    "then": {
     "properties": {
      "arguments": {
       "$ref": "zeoconnect:1.4:pr_list.arguments"
      }
     }
    }
   },
   {
    "if": {
     "properties": {
      "operation_id": {
       "const": "github.ref.read"
      }
     }
    },
    "then": {
     "properties": {
      "arguments": {
       "$ref": "zeoconnect:1.4:ref_read.arguments"
      }
     }
    }
   },
   {
    "if": {
     "properties": {
      "operation_id": {
       "const": "github.fork.sync"
      }
     }
    },
    "then": {
     "properties": {
      "arguments": {
       "$ref": "zeoconnect:1.4:fork_sync.arguments"
      }
     }
    }
   }
  ]
 },
 "zeoconnect:1.4:publish.arguments": {
  "$id": "zeoconnect:1.4:publish.arguments",
  "type": "object",
  "additionalProperties": false,
  "required": [
   "repository",
   "ref",
   "expected_old_sha",
   "parents",
   "changes",
   "message",
   "author"
  ],
  "properties": {
   "repository": {
    "$ref": "zeoconnect:1.4:common#/$defs/repository"
   },
   "ref": {
    "type": "string",
    "pattern": "^refs/heads/.{1,250}$"
   },
   "expected_old_sha": {
    "oneOf": [
     {
      "type": "null"
     },
     {
      "$ref": "zeoconnect:1.4:common#/$defs/sha"
     }
    ]
   },
   "parents": {
    "type": "array",
    "minItems": 1,
    "maxItems": 2,
    "items": {
     "$ref": "zeoconnect:1.4:common#/$defs/sha"
    }
   },
   "changes": {
    "type": "array",
    "minItems": 1,
    "maxItems": 500,
    "items": {
     "oneOf": [
      {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "path",
        "mode",
        "content_base64"
       ],
       "properties": {
        "path": {
         "$ref": "zeoconnect:1.4:common#/$defs/path"
        },
        "mode": {
         "enum": [
          "100644",
          "100755",
          "120000"
         ]
        },
        "content_base64": {
         "type": "string",
         "contentEncoding": "base64",
         "maxLength": 1398104
        }
       }
      },
      {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "path",
        "delete"
       ],
       "properties": {
        "path": {
         "$ref": "zeoconnect:1.4:common#/$defs/path"
        },
        "delete": {
         "const": true
        }
       }
      }
     ]
    }
   },
   "message": {
    "type": "string",
    "minLength": 1,
    "maxLength": 65536
   },
   "author": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "name",
     "email"
    ],
    "properties": {
     "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
     },
     "email": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256
     }
    }
   }
  }
 },
 "zeoconnect:1.4:reconcile.arguments": {
  "$id": "zeoconnect:1.4:reconcile.arguments",
  "type": "object",
  "additionalProperties": false,
  "required": [
   "execution_id"
  ],
  "properties": {
   "execution_id": {
    "$ref": "zeoconnect:1.4:common#/$defs/execution_id"
   }
  }
 },
 "zeoconnect:1.4:resolve.arguments": {
  "$id": "zeoconnect:1.4:resolve.arguments",
