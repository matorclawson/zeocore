{
  "$defs": {
    "CardComponent": {
      "additionalProperties": false,
      "properties": {
        "accessibility_label": {
          "maxLength": 256,
          "title": "Accessibility Label",
          "type": "string"
        },
        "fallback_text": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Fallback Text",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "card",
          "title": "Kind",
          "type": "string"
        },
        "props": {
          "$ref": "#/$defs/CardProps"
        },
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/Snapshot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "title": {
          "maxLength": 256,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "accessibility_label",
        "fallback_text",
        "props"
      ],
      "title": "CardComponent",
      "type": "object"
    },
    "CardProps": {
      "additionalProperties": false,
      "properties": {
        "action_refs": {
          "items": {
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
            "type": "string"
          },
          "maxItems": 0,
          "title": "Action Refs",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "maxItems": 8,
          "title": "Evidence",
          "type": "array"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/Fact"
          },
          "maxItems": 12,
          "title": "Facts",
          "type": "array"
        },
        "progress": {
          "anyOf": [
            {
              "$ref": "#/$defs/Progress"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/$defs/Status"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "summary": {
          "maxLength": 4096,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "summary",
        "facts",
        "evidence",
        "action_refs"
      ],
      "title": "CardProps",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "operation",
            "receipt",
            "document",
            "source"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$",
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "label": {
          "maxLength": 256,
          "title": "Label",
          "type": "string"
        },
        "scale": {
          "anyOf": [
            {
              "maximum": 18,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scale"
        },
        "value": {
          "title": "Value"
        },
        "value_type": {
          "enum": [
            "text",
            "integer",
            "decimal_string",
            "boolean",
            "timestamp",
            "url",
            "null"
          ],
          "title": "Value Type",
          "type": "string"
        }
      },
      "required": [
        "label",
        "value_type",
        "value"
      ],
      "title": "Fact",
      "type": "object"
    },
    "InReplyTo": {
      "additionalProperties": false,
      "properties": {
        "invocation": {
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$",
          "title": "Invocation",
          "type": "string"
        },
        "operation": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "operation",
        "invocation"
      ],
      "title": "InReplyTo",
      "type": "object"
    },
    "Progress": {
      "additionalProperties": false,
      "properties": {
        "current": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Current"
        },
        "total": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "title": "Total"
        },
        "unit": {
          "maxLength": 256,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "current",
        "total",
        "unit"
      ],
      "title": "Progress",
      "type": "object"
    },
    "Snapshot": {
      "additionalProperties": false,
      "properties": {
        "expires_at": {
          "anyOf": [
            {
              "maxLength": 20,
              "minLength": 20,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "observed_at": {
          "maxLength": 20,
          "minLength": 20,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Observed At",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "required": [
        "source",
        "observed_at"
      ],
      "title": "Snapshot",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "operation",
            "receipt",
            "document",
            "source"
          ],
          "title": "Kind",
          "type": "string"
        },
        "ref": {
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$",
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "title": "Source",
      "type": "object"
    },
    "Status": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "healthy",
            "degraded",
            "error",
            "unknown",
            "stale",
            "unavailable"
          ],
          "title": "State",
          "type": "string"
        },
        "text": {
          "maxLength": 256,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "state",
        "text"
      ],
      "title": "Status",
      "type": "object"
    }
  },
  "$id": "https://zeocore.zeo.ac/contracts/zeocore-v1/ui.result-card.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "``zeo.ui-result/v1`` with one read-only card (the zeocore-SOW-42 subset).",
  "properties": {
    "complete": {
      "title": "Complete",
      "type": "boolean"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/CardComponent"
      },
      "maxItems": 1,
      "minItems": 1,
      "title": "Components",
      "type": "array"
    },
    "in_reply_to": {
      "$ref": "#/$defs/InReplyTo"
    },
    "plain_text": {
      "maxLength": 4096,
      "title": "Plain Text",
      "type": "string"
    },
    "produced_at": {
      "maxLength": 20,
      "minLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "title": "Produced At",
      "type": "string"
    },
    "result_id": {
      "pattern": "^[A-Za-z0-9._:/-]{1,128}$",
      "title": "Result Id",
      "type": "string"
    },
    "schema": {
      "const": "zeo.ui-result/v1",
      "title": "Schema",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "result_id",
    "in_reply_to",
    "produced_at",
    "complete",
    "plain_text",
    "components"
  ],
  "title": "UiCardResult",
  "type": "object"
}
