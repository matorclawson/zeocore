{
  "$id": "https://zeocore.zeo.ac/contracts/zeocore-v1/ui.widget-upsert.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "``widget.upsert``: put the referenced data on one card, replacing its older one.",
  "properties": {
    "component": {
      "enum": [
        "flight_status",
        "weather_hourly",
        "arrival_timeline",
        "market_watchlist"
      ],
      "title": "Component",
      "type": "string"
    },
    "data_ref": {
      "pattern": "^[A-Za-z0-9._:/-]{1,128}$",
      "title": "Data Ref",
      "type": "string"
    },
    "request_id": {
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "title": "Request Id",
      "type": "string"
    },
    "revision": {
      "maximum": 2147483647,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "type": {
      "const": "widget.upsert",
      "title": "Type",
      "type": "string"
    },
    "widget_id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
      "title": "Widget Id",
      "type": "string"
    }
  },
  "required": [
    "type",
    "request_id",
    "widget_id",
    "component",
    "data_ref",
    "revision"
  ],
  "title": "WidgetUpsert",
  "type": "object"
}
